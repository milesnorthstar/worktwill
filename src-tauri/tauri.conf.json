{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkTwill",
  "version": "1.3.5",
  "identifier": "app.worktwill.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkTwill",
        "width": 1280,
        "height": 840,
        "center": true,
        "preventOverflow": {
          "width": 48,
          "height": 48
        },
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzNDFENTI1RDM2MzgwODIKUldTQ2dHUFRKZFZCQS9laWcrdmFzbmg5UWpXNjFLa0FDQUpxTkIyQk9uOHhtVS9ETzE2QkJ4QXYK",
      "endpoints": [
        "https://worktwill.haoclub.com/updates/stable/{{target}}-{{arch}}.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
