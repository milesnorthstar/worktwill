  "probeSource": "#import <Foundation/Foundation.h>\n#include <sys/attr.h>\n#include <sys/stat.h>\n#include <sys/mount.h>\n#include <errno.h>\n#include <string.h>\n\nstatic NSDictionary *statSnapshot(const char *path) {\n    struct stat st;\n    if (lstat(path, &st)) return @{ @\"errno\": @(errno) };\n    return @{@\"dev\": @(st.st_dev), @\"inode\": @(st.st_ino), @\"flags\": @(st.st_flags),\n             @\"tracked\": @((st.st_flags & UF_TRACKED) != 0), @\"size\": @(st.st_size),\n             @\"birthSec\": @(st.st_birthtimespec.tv_sec), @\"birthNsec\": @(st.st_birthtimespec.tv_nsec),\n             @\"changeSec\": @(st.st_ctimespec.tv_sec), @\"changeNsec\": @(st.st_ctimespec.tv_nsec),\n             @\"modifySec\": @(st.st_mtimespec.tv_sec), @\"modifyNsec\": @(st.st_mtimespec.tv_nsec)};\n}\nstatic NSDictionary *rawDocument(const char *path, unsigned long options) {\n    struct attrlist al = {0}; al.bitmapcount = ATTR_BIT_MAP_COUNT;\n    al.commonattr = ATTR_CMN_RETURNED_ATTRS | ATTR_CMN_DOCUMENT_ID;\n    unsigned char buf[128] = {0}; errno = 0;\n    int result = getattrlist(path, &al, buf, sizeof(buf), options);\n    if (result) return @{@\"result\": @(result), @\"errno\": @(errno)};\n    uint32_t length; attribute_set_t returned;\n    memcpy(&length, buf, 4); memcpy(&returned, buf + 4, sizeof(returned));\n    uint32_t value = 0;\n    BOOL available = (returned.commonattr & ATTR_CMN_DOCUMENT_ID) != 0;\n    if (available) memcpy(&value, buf + 4 + sizeof(returned), 4);\n    return @{@\"result\": @0, @\"length\": @(length), @\"returnedCommon\": @(returned.commonattr),\n             @\"documentAttributeReturned\": @(available), @\"documentId\": available ? @(value) : [NSNull null]};\n}\nstatic NSDictionary *volumeInfo(const char *path) {\n    struct attrlist al = {0}; al.bitmapcount = ATTR_BIT_MAP_COUNT;\n    al.commonattr = ATTR_CMN_RETURNED_ATTRS;\n    al.volattr = ATTR_VOL_INFO | ATTR_VOL_CAPABILITIES;\n    unsigned char buf[256] = {0};\n    int result = getattrlist(path, &al, buf, sizeof(buf), 0);\n    if (result) return @{@\"result\": @(result), @\"errno\": @(errno)};\n    attribute_set_t returned; vol_capabilities_attr_t caps;\n    memcpy(&returned, buf + 4, sizeof(returned));\n    memcpy(&caps, buf + 4 + sizeof(returned), sizeof(caps));\n    struct statfs fs = {0}; statfs(path, &fs);\n    return @{@\"result\": @0, @\"returnedVolume\": @(returned.volattr),\n       @\"filesystem\": [NSString stringWithUTF8String:fs.f_fstypename],\n       @\"formatCapabilities\": @(caps.capabilities[VOL_CAPABILITIES_FORMAT]),\n       @\"formatValid\": @(caps.valid[VOL_CAPABILITIES_FORMAT]),\n       @\"documentIdCapabilityValid\": @((caps.valid[VOL_CAPABILITIES_FORMAT] & VOL_CAP_FMT_DOCUMENT_ID) != 0),\n       @\"documentIdSupported\": @((caps.capabilities[VOL_CAPABILITIES_FORMAT] & VOL_CAP_FMT_DOCUMENT_ID) != 0)};\n}\nint main(int argc, const char **argv) { @autoreleasepool {\n    NSMutableArray *results = [NSMutableArray array];\n    for (int i = 1; i < argc; i++) {\n        const char *path = argv[i];\n        NSDictionary *before = statSnapshot(path);\n        NSURL *url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path]];\n        id value = nil; NSError *error = nil;\n        BOOL success = [url getResourceValue:&value forKey:NSURLDocumentIdentifierKey error:&error];\n        id volumeUuid = nil; [url getResourceValue:&volumeUuid forKey:NSURLVolumeUUIDStringKey error:NULL];\n        NSDictionary *raw = rawDocument(path, FSOPT_ATTR_CMN_EXTENDED | FSOPT_NOFOLLOW);\n        NSDictionary *after = statSnapshot(path);\n        [results addObject:@{@\"sample\": [[NSString stringWithUTF8String:path] lastPathComponent],\n           @\"before\": before, @\"foundationSuccess\": @(success), @\"foundationDocumentId\": value ?: [NSNull null],\n           @\"foundationErrorCode\": error ? @(error.code) : [NSNull null],\n           @\"volumeUuid\": volumeUuid ?: [NSNull null], @\"rawExtended\": raw,\n           @\"rawWithoutRequiredOption\": rawDocument(path, FSOPT_NOFOLLOW),\n           @\"volume\": volumeInfo(path), @\"after\": after, @\"statUnchanged\": @([before isEqual:after])}];\n    }\n    NSData *json = [NSJSONSerialization dataWithJSONObject:results options:NSJSONWritingPrettyPrinted|NSJSONWritingSortedKeys error:NULL];\n    fwrite(json.bytes, 1, json.length, stdout); fputc('\\n', stdout);\n    return 0;\n}}\n",
